# =============================================================================
# Al-Murshid — environment
#
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# RULE: anything without the NEXT_PUBLIC_ prefix is server-only and is never
# bundled into the browser. The service-role key in particular must never be
# given that prefix — it bypasses Row Level Security entirely.
# =============================================================================

# ── Supabase (client-safe) ───────────────────────────────────────────────────
# Both of these are shipped to the browser by design. The anon key is safe to
# expose because it can read nothing but the v_public_* views.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ── Supabase (SERVER ONLY — never prefix with NEXT_PUBLIC_) ──────────────────
# Used by Server Actions to call the reservation engine. Treat as a password.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Application ──────────────────────────────────────────────────────────────
# Canonical origin. Used for SEO metadata, sitemap and confirmation links.
NEXT_PUBLIC_SITE_URL=https://almurshid.ly

# Random 32+ char secret used to hash IP addresses before they are stored for
# rate limiting, so no raw IP is ever written to the database.
#   openssl rand -hex 32
IP_HASH_SALT=CHANGE-ME-generate-with-openssl-rand-hex-32

# Shared secret for the /api/cron/expire endpoint. Required unless you use the
# pg_cron schedule created by migration 0012.
CRON_SECRET=CHANGE-ME-generate-with-openssl-rand-hex-32

# ── Optional: bot protection (leave blank to disable) ────────────────────────
# Cloudflare Turnstile. When both are set, the booking form requires a token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Optional: local integration tests ────────────────────────────────────────
# Postgres connection string used by tests/integration. Not needed in production.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/almurshid_test
